#!/bin/sh
set -eu

root=$(git rev-parse --show-toplevel)
scratch=$(mktemp -d)
scratch=$(cd "$scratch" && pwd -P)
trap 'printf "Removing pre-push temporary directory: %s\n" "$scratch"; find "$scratch" -depth -delete' EXIT
trap 'exit 1' HUP INT TERM

while read -r local_ref local_oid remote_ref remote_oid; do
    # A deletion has no local object. An annotated tag may point to a commit.
    if [ "$local_ref" = "(delete)" ]; then
        continue
    fi
    if ! commit=$(git rev-parse --verify --quiet "$local_oid^{commit}"); then
        git cat-file -e "$local_oid"
        continue
    fi
    snapshot="$scratch/$commit"
    if [ -d "$snapshot" ]; then
        continue
    fi

    printf 'Testing %s at %s\n' "$local_ref" "$commit"
    mkdir "$snapshot"
    git archive --output="$scratch/source.tar" --format=tar "$commit"
    tar -xf "$scratch/source.tar" -C "$snapshot"
    (
        cd "$snapshot"
        if [ -f "$root/.env.make" ]; then
            make -f "$root/.env.make" -f Makefile test
        else
            make test
        fi
    ) </dev/null
done
